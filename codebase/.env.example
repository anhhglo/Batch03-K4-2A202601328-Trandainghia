# Server-only OpenAI configuration.
# Never expose OPENAI_API_KEY through a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=

# LLM analyzer configuration
LEARNING_TRACE_MODEL=gpt-5-mini
LEARNING_TRACE_PROMPT_VERSION=lt-analyzer-v1
LEARNING_TRACE_TIMEOUT_MS=30000

# Reasoning effort của model gpt-5/o-series: minimal | low | medium | high.
# Bỏ trống thì dùng "low". Đây là yếu tố quyết định độ trễ: đo trên phiên 7 lượt
# × 8 source với gpt-5-nano, mặc định của provider mất 32-35s còn low mất 9-10s
# và cho ra cùng số topic. Tham số này bị bỏ qua với model không phải reasoning.
LEARNING_TRACE_REASONING_EFFORT=low

# Keep false until the CP3 API route is connected and tested.
LEARNING_TRACE_REAL_AI=false
